# ---- runtime ----
NODE_ENV=
PORT=

# ---- auth: jwt lifetime (e.g. 15m) and express session lifetime in ms ----
JWT_SECRET=
SESSION_EXPIRES=
EXPRESS_SECRET=
EXPRESS_SESSION_EXPIRES=

# ---- mysql: one schema, two logins (see documents/database/create-app-users.sql) ----
DB_HOST=
DB_PORT=
DB_NAME=

ADMIN_USER=
ADMIN_PASSWORD=

CHAT_USER=
CHAT_PASSWORD=

# ---- redis: local instance, no auth. set username/password only for a hosted redis ----
REDIS_URL=
REDIS_USERNAME=
REDIS_PASSWORD=

# ---- email: gmail smtp login used for otp mails; APP_NAME appears in the mail text ----
EMAIL_USER=
EMAIL_PASSWORD=
APP_NAME=

# ---- chat limits (optional; blank = default): message length (2000), delete and edit windows (15),
# people in a group including the creator (100), youngest age allowed to sign up (13) ----
MESSAGE_MAX_LENGTH=
MESSAGE_DELETE_WINDOW_MINUTES=
MESSAGE_EDIT_WINDOW_MINUTES=
GROUP_MAX_MEMBERS=
SIGNUP_MIN_AGE=

# ---- push notifications (optional; blank = off): path to the firebase service-account key file.
# local: the downloaded file in the repo root (git-ignored); render: a Secret File, /etc/secrets/<name> ----
FIREBASE_SERVICE_ACCOUNT_FILE=

# ---- uploaded files (optional; blank = server/uploads). a free render instance loses its disk on every
# deploy and restart: point this at a render persistent disk to keep profile photos ----
UPLOADS_DIR=

# ---- app updates (optional; blank = publishing off): a long random secret, the same here and on render.
# `npm run publish-release` sends it; make one with node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" ----
RELEASE_PUBLISH_KEY=

# ---- test runs only: skips the http rate limiter. never set on a deployment ----
RATE_LIMIT_BYPASS=

# ---- switches: enable cron jobs, enable debug logging ----
SCHEDULE_RUN=
SHOW_LOG=
