documents/database/databump-v1.sql
# filled copies of sql scripts carry real passwords
documents/database/*.local.sql
# screenshots taken while testing the ui stay local
documents/screens/
# browser-automation scratch output
.playwright-mcp/

# firebase admin key (secret): never commit
*firebase-adminsdk*.json
firebase-service-account.json
